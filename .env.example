# Postgres container (docker-compose.yml)
POSTGRES_USER=expert
POSTGRES_PASSWORD=expert
POSTGRES_DB=expert_listing
POSTGRES_TEST_DB=expert_listing_test
DB_PORT=5432
API_PORT=8000

# Application (host-side; inside compose the api service points at host `db`)
DATABASE_URL=postgresql+asyncpg://expert:expert@localhost:5432/expert_listing
TEST_DATABASE_URL=postgresql+asyncpg://expert:expert@localhost:5432/expert_listing_test
APP_ENV=local
LOG_LEVEL=INFO
MAX_PAGE_SIZE=100
MAX_RADIUS_KM=100
